{
  "manifest_version": 3,
  "name": "Kick VOD Resume",
  "version": "1.2.0",
  "description": "Remembers Kick VOD playback position, volume, and quality, with a local progress manager.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Kick VOD Resume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kick-16.png",
      "32": "icons/kick-32.png",
      "48": "icons/kick-48.png",
      "128": "icons/kick-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/kick-16.png",
    "32": "icons/kick-32.png",
    "48": "icons/kick-48.png",
    "128": "icons/kick-128.png"
  }
}
